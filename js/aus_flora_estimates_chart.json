{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Dumbbell chart comparing described plant species in Australia and worldwide, based on the DCCEEW 2009 report.",
  "width": 365,
  "height": 290,
  "background": null,
  "data": {"url": "data/australia_world_plant_comparison_long_2009.csv"},
  "transform": [
    {"filter": "datum.measure == 'described_accepted'"}
  ],
  "encoding": {
    "y": {
      "field": "plant_group",
      "type": "nominal",
      "title": null,
      "sort": {"field": "species_midpoint", "op": "max", "order": "descending"},
      "axis": {"ticks": false, "domain": false, "labelPadding": 10}
    },
    "x": {
      "field": "species_midpoint",
      "type": "quantitative",
      "title": "Number of species (log scale)",
      "scale": {"type": "log"},
      "axis": {"format": "~s", "gridDash": [3, 4], "domain": false}
    }
  },
  "layer": [
    {
      "mark": {"type": "line", "strokeWidth": 3, "color": "#B5C9B3"},
      "encoding": {"detail": {"field": "plant_group", "type": "nominal"}}
    },
    {
      "mark": {"type": "point", "filled": true, "size": 160, "opacity": 1},
      "encoding": {
        "color": {
          "field": "region",
          "type": "nominal",
          "title": null,
          "scale": {"domain": ["Australia", "World"], "range": ["#527A58", "#D19D5B"]},
          "legend": {"orient": "top", "symbolType": "circle"}
        },
        "tooltip": [
          {"field": "plant_group", "type": "nominal", "title": "Plant group"},
          {"field": "region", "type": "nominal", "title": "Region"},
          {"field": "species_midpoint", "type": "quantitative", "title": "Number of species", "format": ","}
        ]
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "font": "Ubuntu",
    "axis": {"labelColor": "#304E3B", "titleColor": "#304E3B", "gridColor": "#E1E9DC"},
    "legend": {"labelColor": "#304E3B"}
  }
}




