{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Butterfly chart: number of genera (left) and native species (right) in Australia's 13 largest plant families (1992). Data: ANBG Australian Flora Statistics.",
  "background": null,
  "data": {
    "url": "data/ANBG_largest_plant_families_1992.csv",
    "format": {
      "parse": {
        "australia_genera": "number",
        "australia_native_species": "number"
      }
    }
  },
  "spacing": 0,
  "hconcat": [
    {
      "title": {
        "text": "Number of genera within family",
        "anchor": "end",
        "fontSize": 13,
        "color": "#2F6EA5"
      },
      "width": 450,
      "height": 390,
      "encoding": {
        "y": {
          "field": "family",
          "type": "nominal",
          "sort": {
            "field": "australia_native_species",
            "op": "max",
            "order": "descending"
          },
          "axis": null
        },
        "x": {
          "field": "australia_genera",
          "type": "quantitative",
          "sort": "descending",
          "title": "Number of genera within family",
          "axis": {
            "gridDash": [
              3,
              4
            ],
            "domain": false,
            "tickCount": 4
          }
        }
      },
      "layer": [
        {
          "mark": {
            "type": "bar",
            "color": "#2F6EA5",
            "height": 20
          },
          "encoding": {
            "tooltip": [
              {
                "field": "family",
                "type": "nominal",
                "title": "Family"
              },
              {
                "field": "australia_genera",
                "type": "quantitative",
                "title": "Number of genera"
              }
            ]
          }
        }
      ]
    },
    {
      "width": 130,
      "height": 390,
      "view": {
        "stroke": null
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#304E3B"
      },
      "encoding": {
        "y": {
          "field": "family",
          "type": "nominal",
          "sort": {
            "field": "australia_native_species",
            "op": "max",
            "order": "descending"
          },
          "axis": null
        },
        "text": {
          "field": "family",
          "type": "nominal"
        }
      }
    },
    {
      "title": {
        "text": "Number of native species within family",
        "anchor": "start",
        "fontSize": 13,
        "color": "#C4561B"
      },
      "width": 450,
      "height": 390,
      "encoding": {
        "y": {
          "field": "family",
          "type": "nominal",
          "sort": {
            "field": "australia_native_species",
            "op": "max",
            "order": "descending"
          },
          "axis": null
        },
        "x": {
          "field": "australia_native_species",
          "type": "quantitative",
          "title": "Number of native species within family",
          "axis": {
            "gridDash": [
              3,
              4
            ],
            "domain": false,
            "tickCount": 4,
            "format": ",.0f"
          }
        }
      },
      "layer": [
        {
          "mark": {
            "type": "bar",
            "color": "#C4561B",
            "height": 20
          },
          "encoding": {
            "tooltip": [
              {
                "field": "family",
                "type": "nominal",
                "title": "Family"
              },
              {
                "field": "australia_native_species",
                "type": "quantitative",
                "title": "Number of species",
                "format": ","
              }
            ]
          }
        }
      ]
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Ubuntu",
    "axis": {
      "labelColor": "#304E3B",
      "titleColor": "#304E3B",
      "gridColor": "#E1E9DC"
    }
  }
}