{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Choropleth: for a chosen native plant genus and month of 2025 (0 = whole year), the % of all plant sightings in each state that were of that genus. Normalising by each state's total sightings removes the effect of some states simply recording more plants. Data: ALA 2025 plant occurrences (counted per genus, state and month).",
  "background": null,
  "title": {
    "text": "Recorded sightings of native plant genera by in Australia by states (2025)",
    "anchor": "start",
    "fontSize": 14,
    "subtitleColor": "#607464",
    "color": "#304E3B"
  },
  "params": [
    {
      "name": "Month_selection",
      "value": 0,
      "bind": {
        "input": "range",
        "min": 0,
        "max": 12,
        "step": 1,
        "name": "Month: "
      }
    },
    {
      "name": "Genus_selection",
      "value": "Acacia",
      "bind": {
        "input": "select",
        "options": [
          "Acacia",
          "Eucalyptus",
          "Banksia",
          "Grevillea",
          "Caladenia",
          "Drosera",
          "Lomandra",
          "Pterostylis",
          "Pultenaea",
          "Hibbertia"
        ],
        "labels": [
          "Acacia (wattles)",
          "Eucalyptus (gum trees)",
          "Banksia",
          "Grevillea",
          "Caladenia (spider orchids)",
          "Drosera (sundews)",
          "Lomandra (mat-rushes)",
          "Pterostylis (greenhoods)",
          "Pultenaea (bush-peas)",
          "Hibbertia (guinea flowers)"
        ],
        "name": "Genus: "
      }
    }
  ],
  "vconcat": [
    {
      "width": 845,
      "height": 430,
      "projection": {
        "type": "conicEqualArea",
        "parallels": [
          -18,
          -36
        ],
        "rotate": [
          -134,
          0,
          0
        ]
      },
      "layer": [
        {
          "data": {
            "url": "data/states.geojson",
            "format": {
              "type": "json",
              "property": "features"
            }
          },
          "transform": [
            {
              "calculate": "'No sightings of this genus in ' + datum.properties.STATE_NAME",
              "as": "note"
            }
          ],
          "mark": {
            "type": "geoshape",
            "fill": "#E3E3DE",
            "stroke": "white",
            "strokeWidth": 1
          },
          "encoding": {
            "tooltip": {
              "field": "note"
            }
          }
        },
        {
          "data": {
            "url": "data/genus_state_month_2025.csv",
            "format": {
              "parse": {
                "month": "number",
                "records": "number"
              }
            }
          },
          "transform": [
            {
              "filter": "Month_selection == 0 || datum.month == Month_selection"
            },
            {
              "joinaggregate": [
                {
                  "op": "sum",
                  "field": "records",
                  "as": "state_total"
                }
              ],
              "groupby": [
                "state"
              ]
            },
            {
              "filter": "datum.genus == Genus_selection"
            },
            {
              "aggregate": [
                {
                  "op": "sum",
                  "field": "records",
                  "as": "sightings"
                },
                {
                  "op": "max",
                  "field": "state_total",
                  "as": "state_total"
                }
              ],
              "groupby": [
                "state"
              ]
            },
            {
              "calculate": "datum.sightings / datum.state_total * 100",
              "as": "share"
            },
            {
              "calculate": "datum.share < 0.5 ? 'Under 0.5%' : datum.share < 1 ? '0.5\u20131%' : datum.share < 2 ? '1\u20132%' : datum.share < 4 ? '2\u20134%' : datum.share < 8 ? '4\u20138%' : '8% or more'",
              "as": "share_class"
            },
            {
              "calculate": "['Whole year','January','February','March','April','May','June','July','August','September','October','November','December'][Month_selection]",
              "as": "period"
            },
            {
              "lookup": "state",
              "from": {
                "data": {
                  "url": "data/states.geojson",
                  "format": {
                    "type": "json",
                    "property": "features"
                  }
                },
                "key": "properties.STATE_NAME"
              },
              "as": "geo"
            }
          ],
          "mark": {
            "type": "geoshape",
            "stroke": "white",
            "strokeWidth": 1
          },
          "encoding": {
            "shape": {
              "field": "geo",
              "type": "geojson"
            },
            "color": {
              "field": "share_class",
              "type": "ordinal",
              "title": "% of recorded plant sightings in state",
              "scale": {
                "domain": [
                  "8% or more",
                  "4\u20138%",
                  "2\u20134%",
                  "1\u20132%",
                  "0.5\u20131%",
                  "Under 0.5%"
                ],
                "range": [
                  "#67000D",
                  "#B8202E",
                  "#E8562A",
                  "#FB9A3D",
                  "#FDCC6E",
                  "#FFF5C4"
                ]
              },
              "legend": {
                "orient": "top-left",
                "symbolType": "square",
                "symbolSize": 260,
                "symbolStrokeColor": "#CFC8C0",
                "symbolStrokeWidth": 0.5,
                "fillColor": "rgba(255,255,255,0.85)",
                "padding": 6,
                "labelFontSize": 11
              }
            },
            "tooltip": [
              {
                "field": "state",
                "type": "nominal",
                "title": "State"
              },
              {
                "field": "period",
                "type": "nominal",
                "title": "Period"
              },
              {
                "field": "share",
                "type": "quantitative",
                "title": "% of state's recorded sightings",
                "format": ".1f"
              },
              {
                "field": "sightings",
                "type": "quantitative",
                "title": "Sightings of this genus",
                "format": ","
              },
              {
                "field": "state_total",
                "type": "quantitative",
                "title": "All recorded sightings in state",
                "format": ","
              }
            ]
          }
        }
      ]
    },
    {
      "width": 845,
      "height": 28,
      "data": {
        "sequence": {
          "start": 0,
          "stop": 13,
          "as": "m"
        }
      },
      "transform": [
        {
          "calculate": "['2025 Total','January','February','March','April','May','June','July','August','September','October','November','December'][datum.m]",
          "as": "month_name"
        }
      ],
      "encoding": {
        "x": {
          "field": "month_name",
          "type": "ordinal",
          "sort": {
            "field": "m",
            "op": "min"
          },
          "axis": null
        }
      },
      "layer": [
        {
          "mark": {
            "type": "rect",
            "cornerRadius": 3,
            "stroke": "white",
            "strokeWidth": 2
          },
          "encoding": {
            "color": {
              "condition": {
                "test": "datum.m == Month_selection",
                "value": "#C4561B"
              },
              "value": "#F3EEE8"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 10.5
          },
          "encoding": {
            "text": {
              "field": "month_name"
            },
            "color": {
              "condition": {
                "test": "datum.m == Month_selection",
                "value": "white"
              },
              "value": "#304E3B"
            }
          }
        }
      ]
    }
  ],
  "spacing": 12,
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Ubuntu",
    "legend": {
      "labelColor": "#304E3B",
      "titleColor": "#304E3B"
    }
  }
}