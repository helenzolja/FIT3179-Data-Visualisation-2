{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Choropleth of native and naturalised flora share by Australian state (1992).",
  "width": 420,
  "height": 320,
  "background": null,
  "params": [
    {
      "name": "Flora_selection",
      "value": "Native",
      "bind": {
        "input": "select",
        "options": ["Native", "Naturalised"],
        "name": "Category: "
      }
    }
  ],
  "projection": {
    "type": "conicEqualArea",
    "parallels": [-18, -36],
    "rotate": [-134, 0, 0]
  },
  "data": {
    "url": "data/states.geojson",
    "format": {"type": "json", "property": "features"}
  },
  "layer": [
    {
      "transform": [
        {
          "calculate": "'Data is not available for ' + datum.properties.STATE_NAME",
          "as": "note"
        }
      ],
      "mark": {"type": "geoshape", "fill": "#ddd", "stroke": "white", "strokeWidth": 1},
      "encoding": {"tooltip": {"field": "note"}}
    },
    {
      "transform": [
        {
          "lookup": "properties.STATE_NAME",
          "from": {
            "data": {"url": "data/05_flora_share_by_state_1992.csv"},
            "key": "State",
            "fields": ["Native flora %", "Naturalised flora %"]
          }
        },
        {"calculate": "datum[Flora_selection + ' flora %']", "as": "Percentage"},
        {"filter": "isValid(datum.Percentage)"}
      ],
      "mark": {"type": "geoshape", "stroke": "white", "strokeWidth": 1},
      "encoding": {
        "color": {
          "field": "Percentage",
          "type": "quantitative",
          "title": "Percentage of total flora",
          "scale": {
            "domain": [0, 100],
            "range": [
              {"expr": "Flora_selection == 'Native' ? '#FDE8D4' : '#DDEBF7'"},
              {"expr": "Flora_selection == 'Native' ? '#C4561B' : '#1F5F99'"}
            ]
          },
          "legend": {
            "orient": "bottom",
            "gradientLength": 220,
            "labelExpr": "datum.label + '%'"
          }
        },
        "tooltip": [
          {"field": "properties.STATE_NAME", "type": "nominal", "title": "State"},
          {"field": "Percentage", "type": "quantitative", "title": "Flora share (%)"}
        ]
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "font": "Ubuntu"
  }
}



